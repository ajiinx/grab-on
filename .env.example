# Copy to .env and adjust. Never commit .env or cookie files.

# --- Network -------------------------------------------------------------
# 127.0.0.1 = only this computer. Use `tailscale serve` for phone access
# (see README) rather than binding to 0.0.0.0.
HOST=127.0.0.1
PORT=8000
# If set, the browser asks for a password (any username works).
# Strongly recommended whenever HOST is not 127.0.0.1.
APP_PASSWORD=

# --- Cookies (optional) --------------------------------------------------
# For login-gated Instagram posts and age-restricted YouTube videos.
# Either a Netscape-format cookies.txt exported from your browser...
COOKIES_FILE=
# ...or read them straight from a local browser profile: firefox, chrome,
# edge, brave, "chrome:Profile 1". (Not available inside Docker.)
COOKIES_FROM_BROWSER=

# --- Tools ---------------------------------------------------------------
# Folder containing ffmpeg/ffprobe if they are not on PATH.
FFMPEG_LOCATION=
# JS runtimes yt-dlp may use for YouTube (first one found wins).
JS_RUNTIMES=deno,node,bun
# Write title/artist/date/chapters and the thumbnail (cover art) into files.
EMBED_METADATA=true
# Run `pip install -U yt-dlp` every time the server starts.
YTDLP_AUTO_UPDATE=false

# --- Limits --------------------------------------------------------------
MAX_CONCURRENT_DOWNLOADS=2
# Minutes a finished file stays on disk before it is deleted.
FILE_TTL_MINUTES=30
# Requests per minute per client IP.
RATE_LIMIT_INFO=30
RATE_LIMIT_DOWNLOAD=10

# --- Paths ---------------------------------------------------------------
# DATA_DIR=./data            # history.db
# DOWNLOAD_DIR=./downloads   # temporary per-job folders
